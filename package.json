{
  "name": "ccusage-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local web dashboard for visualizing coding agent token usage with ccusage.",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@fastify/static": "^8.2.0",
    "antd": "^6.0.0",
    "dayjs": "^1.11.18",
    "echarts": "^6.0.0",
    "fastify": "^5.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
